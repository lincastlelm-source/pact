<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Compose theme does the real work; this exists so the window has sane colours before
      the first frame and so the launcher/splash does not flash white in dark mode.
    -->
    <style name="Theme.PACT" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
